{
  "name": "personal-knowledge-base",
  "version": "1.0.0",
  "description": "A simple AI-driven knowledge management system using Gemini API.",
  "keywords": [],
  "homepage": "https://github.com/IzawaNanako/personal-knowledge-base#readme",
  "bugs": {
    "url": "https://github.com/IzawaNanako/personal-knowledge-base/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IzawaNanako/personal-knowledge-base.git"
  },
  "license": "GPL-3.0-only",
  "author": "Wither (https://github.com/IzawaNanako)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "ingest": "node dist/ingest.js",
    "postingest": "dprint fmt \"wiki/*.md\" --no-gitignore",
    "query": "node dist/query.js",
    "postquery": "dprint fmt \"wiki/**/*.md\" \"output/**/*.md\" --no-gitignore"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "dprint": "0.55.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
